# 將完整連線網址貼在本機 .env，請勿提交實際密碼。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
DB_SCHEMA=breakfast_shop
PORT=3000
# BASE_URL=https://your-site.example
# BOSS_PASSWORD=replace-before-first-start
# 正式環境 NODE_ENV=production 時，BOSS_PASSWORD 必須至少 12 字元。
# Render 公開網址會由 RENDER_EXTERNAL_URL 自動取得。
